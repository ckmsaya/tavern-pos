{
  "name": "tavern-print-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Local bridge service so the Tavern POS (running in a browser) can print receipts and open the cash drawer on a USB receipt printer.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/tavern-print-helper.exe"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.11.0"
  },
  "pkg": {
    "assets": ["winprint.ps1", "config.json"]
  }
}
