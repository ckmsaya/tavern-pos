# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
print-helper/node_modules
print-helper/dist
print-helper/*.prn
# Machine-specific runtime config (printer name, business name, allowed
# origins) generated on first run — see print-helper/default-config.js
# for the template committed to the repo instead.
print-helper/config.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# editor
.vscode

# typescript
*.tsbuildinfo
next-env.d.ts
